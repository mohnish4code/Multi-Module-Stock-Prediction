# Copy to .env and adjust. Never commit .env.

# API
RATE_LIMIT=30/minute
# Pre-run every ticker at startup so the first requests are fast (good for demos)
WARMUP=1
LOG_LEVEL=INFO
API_PORT=8000

# MLflow (local runs default to sqlite:///mlflow.db; set MLFLOW_DISABLE=1 to turn tracking off)
MLFLOW_TRACKING_URI=
MLFLOW_PORT=5000

# Optional: Hugging Face token for faster/higher-limit FinBERT downloads
HF_TOKEN=
